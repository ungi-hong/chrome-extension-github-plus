{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/features/*/", "**/features/*/**"],
            "message": "features/<a>/ から features/<b>/ への import は禁止です。機能は独立させてください。共通処理は src/shared/ または src/content/ 直下に置いてください。"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/content/features/index.ts", "src/content/index.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "*.config.ts", "*.config.js"]
}
