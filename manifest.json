{
  "manifest_version": 3,
  "name": "GitHub Plus",
  "version": "0.1.0",
  "description": "Make GitHub editing a little nicer.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options/index.html"
}
